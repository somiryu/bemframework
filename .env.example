# ==========================================================
# BEM Framework Environment Configuration Example
# ==========================================================

# Database Mode: 'local' (default for local development) or 'supabase' (for dev:supabase or Netlify production)
DB_MODE=local

# Local PostgreSQL Database URL (used when DB_MODE=local)
DATABASE_URL=postgresql://freetoplay@localhost:5432/bem_dev

# Supabase Cloud Configuration (used when DB_MODE=supabase and in Netlify production)
PUBLIC_SUPABASE_URL=https://trwjxokjhvkhlmxtboun.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service_role key (server-only, bypasses RLS) — required when DB_MODE=supabase,
# used by src/lib/server/db.ts. Get it from Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# BEM AI ("Discípulo BEM") — see src/routes/api/ai/+server.ts
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.0-flash
BEM_MCP_URL=https://bem-mcp.onrender.com/mcp
BEM_MCP_TOKEN=your_bem_mcp_token_here
